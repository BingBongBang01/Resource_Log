{
    "system_collection_interval_ms": 30000,
    "process_collection_interval": 60,
    "gpu_collection_interval_ms": 10000,
    "auto_start_recording": true,
    "auto_export_on_exit": true,
    "export_directory": "C:\\Users\\thk\\Desktop\\log",
    "language": "ko",
    "start_on_boot": true,
    "log_fields": {
        "cpu_usage": true,
        "cpu_freq_mhz": true,
        "cpu_temperature": true,
        "ram_used": true,
        "ram_available": true,
        "ram_total": true,
        "ram_usage_percent": true,
        "gpu_usage": true,
        "gpu_vram_used": true,
        "gpu_temperature": true,
        "fps": true,
        "fps_avg": true,
        "fps_min": true,
        "fps_max": true,
        "frame_time": true
    },
    "overlay_enabled": true,
    "overlay_position": "top_left",
    "overlay_items": {
        "cpu_usage": false,
        "cpu_temp": false,
        "ram_used": true,
        "ram_percent": true,
        "gpu_usage": false,
        "gpu_vram": false,
        "gpu_temp": false,
        "fps": true,
        "fps_avg": false,
        "fps_min": false,
        "fps_max": false,
        "frame_time": false
    },
    "overlay_text_opacity": 1.0,
    "overlay_bg_opacity": 0.0,
    "overlay_font_size": 28,
    "overlay_text_color": "#39FF14",
    "overlay_bg_color": "#000000"
}